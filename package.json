{
  "name": "alstate",
  "version": "0.0.0",
  "private": true,
  "description": "A modular learning-state engine.",
  "type": "module",
  "bin": {
    "alstate": "./dist/interfaces/cli/main.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run build && npm test",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/interfaces/cli/main.ts",
    "prebuild": "npm run clean",
    "pretest": "node --eval \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "start": "node dist/interfaces/cli/main.js",
    "test": "tsc --project tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\"",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.1"
  }
}
